{
  "name": "umtuba-mobile",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "regression:task-check": "node scripts/regression-lock/run.mjs task-check",
    "regression:baseline-check": "node scripts/regression-lock/run.mjs baseline-check",
    "regression:scope-check": "node scripts/regression-lock/run.mjs scope-check",
    "regression:contracts": "node scripts/regression-lock/run.mjs contracts",
    "regression:pre-eas": "node scripts/regression-lock/run.mjs pre-eas",
    "regression:snapshot": "node scripts/regression-lock/run.mjs snapshot",
    "regression:device-required": "node scripts/regression-lock/run.mjs device-required",
    "regression:build-lock": "node scripts/regression-lock/run.mjs build-lock"
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "listUnknownPackages": false
      }
    }
  },
  "dependencies": {
    "@maplibre/maplibre-react-native": "^11.3.6",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.110.5",
    "expo": "~57.0.7",
    "expo-constants": "~57.0.6",
    "expo-device": "^57.0.1",
    "expo-font": "~57.0.1",
    "expo-haptics": "~57.0.2",
    "expo-image-picker": "~57.0.5",
    "expo-linking": "~57.0.3",
    "expo-localization": "~57.0.1",
    "expo-media-library": "57.0.3",
    "expo-notifications": "~57.0.6",
    "expo-router": "~57.0.7",
    "expo-secure-store": "^57.0.1",
    "expo-sharing": "~57.0.6",
    "expo-splash-screen": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.1",
    "expo-video": "^57.0.1",
    "expo-web-browser": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.0",
    "react-native-reanimated": "4.5.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.2",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.0.1",
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3",
    "vitest": "^4.1.10"
  }
}
